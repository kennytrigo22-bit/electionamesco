<IfModule LiteSpeed>
    # Cette application est entierement dynamique (Livewire) : la mettre en
    # cache cote serveur (LSCache, souvent active par defaut chez l'hebergeur)
    # provoque des erreurs "405 Method Not Allowed" sur /livewire/update et
    # des boucles de session expiree. On la desactive donc completement ici.
    CacheLookup off
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    # Uses 308 (not 301): a 301 on a POST makes browsers replay the follow-up
    # request as GET, which turned a Livewire AJAX update into a 405 whenever
    # its URL carried a trailing slash. 308 preserves the method and body.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=308]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
